import tensorflow as tf
from tensorflow.keras import layers, models
import matplotlib.pyplot as plt
import numpy as np
mnist = tf.keras.datasets.mnist
(X_train, y_train), (X_test, y_test) = mnist.load_data()
X_train, X_test = X_train / 255.0, X_test / 255.0
print(f"Training data shape: {X_train.shape}")
print(f"Test data shape: {X_test.shape}")
plt.figure(figsize=(10, 4))
for i in range(5):
    plt.subplot(1, 5, i + 1)
    plt.imshow(X_train[i], cmap='gray')
    plt.title(f"Label: {y_train[i]}")
    plt.axis('off')
plt.show()
model = models.Sequential([
    layers.Flatten(input_shape=(28, 28)),
    layers.Dense(128, activation='relu'),
    layers.Dense(10, activation='softmax')])
model.summary()
model.compile(optimizer='adam', loss='sparse_categorical_crossentropy', metrics=['accuracy'])
history = model.fit(X_train, y_train, epochs=5, validation_split=0.1, batch_size=64)
test_loss, test_acc = model.evaluate(X_test, y_test, verbose=2)
print(f"\nTest Accuracy: {test_acc:.4f}")
sample_idx = 0
prediction = model.predict(np.expand_dims(X_test[sample_idx], axis=0))
predicted_label = np.argmax(prediction)

plt.imshow(X_test[sample_idx], cmap='gray')
plt.title(f"True Label: {y_test[sample_idx]} | Predicted: {predicted_label}")
plt.axis('off')
plt.show()
  
  

for data in [df, df1]:
    data['Item_Fat_Content'] = data['Item_Fat_Content'].replace({'LF': 'Low Fat', 'low fat': 'Low Fat', 'reg': 'Regular'})
y_raw = df["Item_Outlet_Sales"]
X_raw = df.drop(columns=["Item_Identifier", "Item_Outlet_Sales"], errors='ignore')
X_test_raw = df1.drop(columns=["Item_Identifier"], errors='ignore')
categorical_cols = ['Item_Fat_Content', 'Item_Type', 'Outlet_Identifier', 'Outlet_Size', 'Outlet_Location_Type', 'Outlet_Type']
X_encoded = pd.get_dummies(X_raw, columns=categorical_cols, drop_first=True, dtype=float)
X_test_encoded = pd.get_dummies(X_test_raw, columns=categorical_cols, drop_first=True, dtype=float)
X_encoded, X_test_encoded = X_encoded.align(X_test_encoded, join='left', axis=1, fill_value=0)
X_train_split, X_val_split, y_train_split, y_val_split = train_test_split(X_encoded, y_raw, test_size=0.2, random_state=42)
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
print(f"Using device: {device}")
scaler = StandardScaler()
X_train_scaled = scaler.fit_transform(X_train_split)
X_val_scaled = scaler.transform(X_val_split)
X_test_scaled = scaler.transform(X_test_encoded)
y_scaler = StandardScaler()
y_train_scaled = y_scaler.fit_transform(y_train_split.values.reshape(-1, 1))
y_val_scaled = y_scaler.transform(y_val_split.values.reshape(-1, 1))
x_train_tensor = torch.tensor(X_train_scaled, dtype=torch.float32).to(device)
y_train_tensor = torch.tensor(y_train_scaled, dtype=torch.float32).to(device)
x_val_tensor = torch.tensor(X_val_scaled, dtype=torch.float32).to(device)

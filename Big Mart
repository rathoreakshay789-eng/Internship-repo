x_test_tensor = torch.tensor(X_test_scaled, dtype=torch.float32).to(device)
input_dimensions = x_train_tensor.shape[1]
model = Big_mart(input_dim=input_dimensions).to(device)

optimiser = optim.AdamW(model.parameters(), lr=0.005, weight_decay=1e-4)
criterion = nn.MSELoss()
epochs = 100
train_losses = []
val_losses = []

for i in range(epochs):
    model.train()
    y_predict = model(x_train_tensor)
    loss = criterion(y_predict, y_train_tensor)
    optimiser.zero_grad()
    loss.backward()
    optimiser.step()
    model.eval()
    with torch.no_grad():
        y_val_predict = model(x_val_tensor)
        val_loss = criterion(y_val_predict, y_val_tensor)
        
    train_losses.append(loss.item())
    val_losses.append(val_loss.item())
    
    if i % 10 == 0:
        print(f"Epoch {i:03d} | Train Loss: {loss.item():.4f} | Val Loss: {val_loss.item():.4f}")

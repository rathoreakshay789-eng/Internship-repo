class Big_mart(nn.Module):
    def __init__(self, input_dim):
        super().__init__()
        self.l1 = nn.Linear(in_features=input_dim, out_features=128)
        self.bn1 = nn.BatchNorm1d(128)
        self.dropout1 = nn.Dropout(0.3)
        
        self.l2 = nn.Linear(in_features=128, out_features=64)
        self.bn2 = nn.BatchNorm1d(64)
        self.dropout2 = nn.Dropout(0.2)
        
        self.l3 = nn.Linear(in_features=64, out_features=32)
        self.l4 = nn.Linear(in_features=32, out_features=1)
        self.relu = nn.ReLU()

    def forward(self, x):
        x = self.dropout1(self.relu(self.bn1(self.l1(x))))
        x = self.dropout2(self.relu(self.bn2(self.l2(x))))
        x = self.relu(self.l3(x))
        x = self.l4(x)
        return x
